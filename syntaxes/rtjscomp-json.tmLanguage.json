{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "rtjscomp JSON",
	"scopeName": "source.json.rtjscomp",
	"patterns": [
		{ "include": "#embedded-javascript-expression" },
		{ "include": "#embedded-javascript" },
		{ "include": "source.json" }
	],
	"repository": {
		"embedded-javascript-expression": {
			"name": "meta.embedded.expression.javascript.rtjscomp",
                        "begin": "<\\?[:=]",
			"beginCaptures": {
				"0": { "name": "punctuation.section.embedded.begin.php" }
			},
			"end": "\\?>",
			"endCaptures": {
				"0": { "name": "punctuation.section.embedded.end.php" }
			},
			"contentName": "source.js.embedded.rtjscomp",
			"patterns": [
				{ "include": "source.js" }
			]
		},
		"embedded-javascript": {
			"name": "meta.embedded.block.javascript.rtjscomp",
			"begin": "<\\?",
			"beginCaptures": {
				"0": { "name": "punctuation.section.embedded.begin.php" }
			},
			"end": "\\?>",
			"endCaptures": {
				"0": { "name": "punctuation.section.embedded.end.php" }
			},
			"contentName": "source.js.embedded.rtjscomp",
			"patterns": [
				{ "include": "source.js" }
			]
		}
	}
}
